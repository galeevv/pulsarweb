# Local defaults work without this file. Copy to .env to customize.
# Origin only, without credentials, a subdirectory, query or fragment.
SITE_URL=http://localhost:3000
# Filesystem path relative to the project root, or an absolute file: path.
# Prisma CLI uses the same .env* precedence as Next; set NODE_ENV=production on deploy.
DATABASE_URL=file:./prisma/pulsarweb.db

# Enable only behind a trusted proxy that overwrites x-real-ip.
TRUST_PROXY=false

# Optional owner notifications. Leave each group empty to disable it.
# Partial/invalid groups are disabled with a safe warning; lead storage still works.
# Restart the server after changing these values.
# Telegram: bot token and numeric chat ID (or public @channel username).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=885112484
TELEGRAM_OWNER_USERNAME=galeev66
# Legacy TELEGRAM_CHAT_ID is still accepted if OWNER_CHAT_ID is unset.
# Resend: re_ API key, a verified sender address, and the owner's recipient address.
# EMAIL_FROM is a plain email address, without a display name.
RESEND_API_KEY=
EMAIL_FROM=
LEAD_NOTIFICATION_EMAIL=
