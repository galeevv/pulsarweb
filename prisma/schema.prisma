generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id                 String   @id @default(cuid())
  publicId           String   @unique
  requestKind        String
  status             String   @default("NEW")
  consent            Boolean  @default(true)
  companyContext     String?
  projectReference   String?
  timeline           String?
  sourceUrl          String?
  referrer           String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  updatedAt          DateTime @updatedAt
  submissionId       String   @unique
  payloadHash        String
  name               String
  company            String?
  email              String?
  phone              String?
  telegram           String?
  service            String
  budget             String?
  description        String   @map("message")
  consentVersion     String
  consentAt          DateTime @default(now())
  notificationStatus String   @default("pending")
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([notificationStatus])
}

model RateLimitBucket {
  key       String @id
  hits      Int
  expiresAt BigInt

  @@index([expiresAt])
}

model LeadSequence {
  id Int @id
  value Int
}
